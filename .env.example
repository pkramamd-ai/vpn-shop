# =============================================================================
# VPN Shop Bot — environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env && nano .env
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
# Get from @BotFather: /newbot or /token
TELEGRAM_TOKEN=REPLACE_ME

# Default UI language (ru / en / zh). Per-user language is auto-detected from
# the Telegram client; this is the fallback.
DEFAULT_LANGUAGE=ru

# Telegram numeric ID of the bot admin (use @userinfobot to find it)
ADMIN_TELEGRAM_ID=REPLACE_ME

# Mini App URL (HTTPS, served from your own domain). Leave empty to disable.
# Telegram requires HTTPS with a valid certificate.
MINI_APP_URL=

# Telegram numeric IDs blocked from using the bot (comma-separated)
BLOCKED_TELEGRAM_IDS=

# Telegram numeric IDs allowed to bypass anti-fraud checks (comma-separated)
WHITELISTED_TELEGRAM_IDS=

# Optional proxy for Telegram Bot API (HTTP/HTTPS/SOCKS5)
# Example: socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# -----------------------------------------------------------------------------
# Pricing — RUB (YooKassa / CryptoBot equivalents) and Telegram Stars
# TODO: replace placeholders with your real prices
# -----------------------------------------------------------------------------
PRICE_1=199
PRICE_3=499
PRICE_6=899
PRICE_12=1599

STARS_PRICE_1=199
STARS_PRICE_3=499
STARS_PRICE_6=899
STARS_PRICE_12=1599

# Days counted as a "month" for subscriptions
DAYS_IN_MONTH=30

# Traffic cap per subscription in GB (0 = unlimited)
TRAFFIC_LIMIT=0

# Free trial settings (set TRIAL_DAYS=0 to disable)
TRIAL_DAYS=0
TRIAL_TRAFFIC_LIMIT=10
TRIAL_INTERNAL_SQUADS=
TRIAL_EXTERNAL_SQUAD_UUID=
TRIAL_REMNAWAVE_TAG=

# Referral bonus in days granted to inviter on each invitee's first paid
# subscription (0 = referral system disabled)
REFERRAL_DAYS=7

# -----------------------------------------------------------------------------
# Remnawave panel integration
# -----------------------------------------------------------------------------
# Public URL of your Remnawave panel (with scheme).
# If REMNAWAVE_MODE=local and panel runs in the same docker network, you can
# use http://remnawave:3000
REMNAWAVE_URL=https://panel.example.com

# remote (default) or local. Use local only when bot runs in same docker
# network as the panel.
REMNAWAVE_MODE=remote

# API token from Remnawave Settings → API Tokens
REMNAWAVE_TOKEN=REPLACE_ME

# Tag assigned to paid users in Remnawave (lets you filter buyers in panel)
REMNAWAVE_TAG=SHOP_USER

# Optional extra HTTP headers for Remnawave requests, format: key1:value1;key2:value2
# Example: X-Api-Key:foo;X-Custom:bar
REMNAWAVE_HEADERS=

# Squad UUIDs to assign to a user after purchase (comma-separated)
# Example: 773db654-a8b2-413a-a50b-75c3536238fd,bc979bdd-f1fa-4d94-8a51-38a0f518a2a2
SQUAD_UUIDS=

# External squad UUID (single value, optional)
EXTERNAL_SQUAD_UUID=

# -----------------------------------------------------------------------------
# Payments — enable what you have. All three (Stars / YooKassa / CryptoBot)
# can be active at the same time.
# -----------------------------------------------------------------------------

# Telegram Stars (XTR). Built into Telegram, no extra credentials needed.
TELEGRAM_STARS_ENABLED=true
# If true, user must pay at least once via card or crypto before they can pay
# with Stars. Anti-fraud measure.
REQUIRE_PAID_PURCHASE_FOR_STARS=false

# YooKassa (rubles, bank cards). Get keys at https://yookassa.ru
YOOKASA_ENABLED=false
YOOKASA_SECRET_KEY=
YOOKASA_SHOP_ID=
YOOKASA_URL=https://api.yookassa.ru/v3
YOOKASA_EMAIL=

# CryptoBot / CryptoPay (crypto). Get token at @CryptoBot in Telegram.
CRYPTO_PAY_ENABLED=false
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_URL=https://pay.crypt.bot

# Moy Nalog — automatic receipt issuance for self-employed (RU). Optional.
MOYNALOG_ENABLED=false
MOYNALOG_USERNAME=
MOYNALOG_PASSWORD=
MOYNALOG_URL=https://lknpd.nalog.ru/api/v1
MOYNALOG_PROXY_URL=

# -----------------------------------------------------------------------------
# Public URLs shown as buttons in the bot (leave empty to hide)
# -----------------------------------------------------------------------------
SERVER_STATUS_URL=
SUPPORT_URL=
FEEDBACK_URL=
CHANNEL_URL=
TOS_URL=

# -----------------------------------------------------------------------------
# Database (Postgres). Defaults work with the bundled docker-compose.
# Change credentials before exposing the DB outside the host.
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres?sslmode=disable
